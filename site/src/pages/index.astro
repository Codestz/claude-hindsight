}
.ft-line { display: flex; gap: 0.25rem; line-height: 1.7; }

.fc-tags { display: flex; flex-direction: column; gap: 0.375rem; }
.fc-tag {
  font-family: var(--sans);
  font-size: 13px;
  color: var(--text-2);
  display: flex;
  gap: 0.625rem;
}

/* Session explorer tree */
.fc-tree {
  font-family: var(--code);
  font-size: 12px;
  line-height: 1.8;
}
.ftt { display: block; white-space: pre; }

/* Live feed */
.fc-live-feed { display: flex; flex-direction: column; gap: 3px; margin-bottom: 0; font-family: var(--code); font-size: 13px; }
.live-row { display: flex; align-items: center; gap: 0.75rem; padding: 4px 0; color: var(--text-2); }
.live-row--active { color: var(--text-1); }
.live-time { font-size: 11px; color: var(--text-2); flex-shrink: 0; }

/* Token chart */
.fc-chart { font-family: var(--code); font-size: 13px; }
.tkn-row { display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.625rem; }
.tkn-lbl { font-size: 11px; width: 46px; flex-shrink: 0; color: var(--text-2); }
.tkn-bar { flex: 1; height: 5px; background: var(--border-2); overflow: hidden; }
.tkn-fill { display: block; height: 100%; background: var(--accent); opacity: 0.75; }
.bc { background: var(--cyan); }
.ba { background: var(--amber); }
.tkn-val { font-size: 12px; width: 44px; text-align: right; }
.tkn-div { height: 1px; background: var(--border); margin: 1rem 0; }
.tkn-sum { display: flex; justify-content: space-between; }
.tkn-total { font-size: 16px; font-weight: 700; margin-top: 4px; }

/* Dual interface */
.fc-dual-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1.25rem; align-items: start; }
.dual-sep { width: 1px; background: var(--border); align-self: stretch; }
.dual-label {
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.875rem;
}
.dual-code {
  font-family: "JetBrains Mono", monospace;
  font-size: 12px;
  line-height: 1.75;
  color: var(--text-1);
  display: flex;
  flex-direction: column;
  margin-bottom: 0.875rem;
}
.dual-meta {
  font-family: var(--sans);
  font-size: 12px;
  color: var(--text-2);
}

/* Local first */
.fc-list { display: flex; flex-direction: column; gap: 0.5rem; }
.local-item {
  font-family: var(--sans);
  font-size: 14px;
  display: flex;
  gap: 0.75rem;
  color: var(--text-2);
  line-height: 1.55;
}

