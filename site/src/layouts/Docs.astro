---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title = "Docs — Claude Hindsight",
  description = "Claude Hindsight documentation.",
  headings = [],
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = "https://codestz.github.io/claude-hindsight";
const ogImage = `${siteUrl}/og.svg`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const sections = [
  {
    label: "Get Started",
    pages: [
      { href: `${base}/docs/getting-started`, label: "Introduction" },
      { href: `${base}/docs/hooks`,            label: "Hooks Setup"  },
    ],
  },
  {
    label: "Your Sessions",
    pages: [
      { href: `${base}/docs/dashboard`, label: "Web Dashboard" },
    ],
  },
  {
    label: "Reference",
    pages: [
      { href: `${base}/docs/commands`,       label: "CLI Commands"    },
      { href: `${base}/docs/configuration`,  label: "Configuration"   },
      { href: `${base}/docs/troubleshooting`, label: "Troubleshooting" },
    ],
  },
  {
    label: "Contributing",
    pages: [{ href: `${base}/docs/contributing`, label: "Contributing" }],
  },
];

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050505" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Claude Hindsight" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav />

    <!-- Mobile sidebar toggle -->
    <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="docs-sidebar">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect y="2" width="14" height="1.2" fill="currentColor"/>
        <rect y="6.4" width="14" height="1.2" fill="currentColor"/>
        <rect y="10.8" width="14" height="1.2" fill="currentColor"/>
      </svg>
      MENU
    </button>
    <div id="sidebar-overlay"></div>

    <div class="docs-layout">

      <!-- ── Left Sidebar ─────────────────────── -->
      <aside id="docs-sidebar">
        <button class="sidebar-close" id="sidebar-close" aria-label="Close navigation">✕</button>
        {sections.map((section) => (
          <div class="sb-group">
            <div class="sb-group-label">{section.label}</div>
            {section.pages.map((page) => {
              const active = currentPath === page.href || currentPath === page.href + "/";
              return (
                <a
                  href={page.href}
                  class={`sb-link ${active ? "sb-link--active" : ""}`}
                >
                  {page.label}
                </a>
              );
            })}
          </div>
        ))}
      </aside>

      <!-- ── Main Content ──────────────────────── -->
      <main class="docs-main">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={`${base}/docs/getting-started`} class="bc-link">Docs</a>
          <span class="bc-sep">›</span>
          <span class="bc-current">{title.split(" — ")[0]}</span>
        </nav>

        <article class="prose-doc">
          <slot />
        </article>

        <!-- Edit on GitHub -->
        <div class="edit-link-wrap">
          <a
            href={`https://github.com/Codestz/claude-hindsight/tree/main/site/src/pages${currentPath.replace(base, "")}.md`}
            target="_blank"
            rel="noopener noreferrer"
            class="edit-link"
          >
            Edit this page on GitHub →
          </a>
        </div>
      </main>

      <!-- ── Right ToC ─────────────────────────── -->
      {tocHeadings.length > 0 && (
        <aside id="docs-toc">
          <div class="toc-label">On this page</div>
          <nav>
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class={`toc-link toc-link--h${h.depth}`}
                data-slug={h.slug}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </aside>
      )}

    </div>

    <Footer />
  </body>
</html>

<!-- Mobile sidebar toggle -->
<script>
  const toggle   = document.getElementById("sidebar-toggle")!;
  const closeBtn = document.getElementById("sidebar-close")!;
  const overlay  = document.getElementById("sidebar-overlay")!;
  const sidebar  = document.getElementById("docs-sidebar")!;

  function openSidebar() {
    sidebar.classList.add("is-open");
    overlay.classList.add("is-open");
    toggle.setAttribute("aria-expanded", "true");
  }
  function closeSidebar() {
    sidebar.classList.remove("is-open");
    overlay.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
  }

  toggle.addEventListener("click", openSidebar);
  closeBtn.addEventListener("click", closeSidebar);
  overlay.addEventListener("click", closeSidebar);
  sidebar.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeSidebar));
</script>

<!-- Active ToC highlight via IntersectionObserver -->
<script>
  const links = document.querySelectorAll<HTMLAnchorElement>("#docs-toc .toc-link");
  if (links.length) {
    const headingEls = Array.from(links)
      .map((l) => document.getElementById(l.dataset.slug ?? ""))
      .filter(Boolean) as HTMLElement[];

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove("toc-link--active"));
            const active = document.querySelector(`#docs-toc [data-slug="${entry.target.id}"]`);
            active?.classList.add("toc-link--active");
            break;
          }
        }
      },
      { rootMargin: "-48px 0px -60% 0px" }
    );

    headingEls.forEach((el) => observer.observe(el));
  }
</script>

<style is:global>

/* ── Page shell ──────────────────────────────── */
body {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  padding-top: 48px;
  font-family: "Inter", system-ui, sans-serif;
}

.docs-layout {
  display: flex;
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* ── Left sidebar ────────────────────────────── */
#docs-sidebar {
  width: 256px;
  flex-shrink: 0;
  background: var(--bg-2);
  border-right: 1px solid var(--border);
  padding: 2rem 1rem;
  position: sticky;
  top: 48px;
  height: calc(100vh - 48px);
  overflow-y: auto;
}

.sb-group { margin-bottom: 2rem; }

.sb-group-label {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-3);
  padding: 0 0.75rem;
  margin-bottom: 0.5rem;
}

.sb-link {
  display: block;
  padding: 0.5rem 0.75rem;
  font-family: "Inter", system-ui, sans-serif;
  font-size: 14px;
  font-weight: 400;
  color: var(--text-2);
  text-decoration: none;
  border-radius: 4px;
  margin-bottom: 2px;
  transition: color 0.1s, background 0.1s;
}
.sb-link:hover {
  color: var(--text-1);
  background: rgba(255,255,255,0.04);
}
.sb-link--active {
  color: var(--text-1);
  font-weight: 500;
  background: rgba(129,140,248,0.07);
  border-left: 2px solid var(--accent);
  padding-left: calc(0.75rem - 2px);
}

/* ── Main content ────────────────────────────── */
.docs-main {
  flex: 1;
  min-width: 0;
  padding: 2.5rem 3.5rem;
}

/* ── Breadcrumb ──────────────────────────────── */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
}
.bc-link {
  font-size: 13px;
  color: var(--text-2);
  text-decoration: none;
  transition: color 0.1s;
}
.bc-link:hover { color: var(--text-1); }
.bc-sep { color: var(--text-3); font-size: 13px; }
.bc-current { font-size: 13px; color: var(--accent); font-weight: 500; }

/* ── Edit link ───────────────────────────────── */
.edit-link-wrap {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}
.edit-link {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 13px;
  color: var(--text-3);
  text-decoration: none;
  transition: color 0.1s;
}
.edit-link:hover { color: var(--accent); }

/* ── Right ToC ───────────────────────────────── */
#docs-toc {
  width: 220px;
  flex-shrink: 0;
  padding: 2.5rem 1.5rem 2.5rem 1rem;
  position: sticky;
  top: 48px;
  height: calc(100vh - 48px);
  overflow-y: auto;
  border-left: 1px solid var(--border);
}

.toc-label {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-3);
  margin-bottom: 0.875rem;
}

.toc-link {
  display: block;
  font-family: "Inter", system-ui, sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: var(--text-3);
  text-decoration: none;
  padding: 0.3rem 0.5rem;
  border-left: 2px solid transparent;
  margin-bottom: 1px;
  transition: color 0.15s, border-color 0.15s;
  line-height: 1.45;
}
.toc-link:hover { color: var(--text-1); }
.toc-link--h3 { padding-left: 1.125rem; font-size: 12px; }
.toc-link--active {
  color: var(--accent) !important;
  border-left-color: var(--accent);
  font-weight: 500;
}

/* ── Prose typography ────────────────────────── */
.prose-doc {
  font-family: "Inter", system-ui, sans-serif;
  color: var(--text-2);
  line-height: 1.75;
  font-size: 0.9375rem;
}

/* Page title */
.prose-doc h1 {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 2.25rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  margin: 0 0 0.625rem;
  color: var(--text-1);
  line-height: 1.1;
}

/* Subtitle — first <p> after h1 */
.prose-doc h1 + p {
  font-size: 1.0625rem;
  color: var(--text-2);
  margin: 0 0 2.5rem;
  line-height: 1.65;
}

/* Section headings — h2 */
.prose-doc h2 {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 1.375rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  margin: 3rem 0 1rem;
  color: var(--text-1);
  padding-bottom: 0.625rem;
  border-bottom: 1px solid var(--border-2);
  line-height: 1.25;
}

/* Sub-section headings — h3 */
.prose-doc h3 {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 1.0625rem;
  font-weight: 600;
  letter-spacing: -0.015em;
  margin: 2rem 0 0.625rem;
  color: var(--text-1);
  line-height: 1.3;
}

/* h4 */
.prose-doc h4 {
  font-size: 0.75rem;
  font-weight: 600;
  margin: 1.5rem 0 0.5rem;
  color: var(--text-1);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.prose-doc p { margin: 0 0 1.125rem; }

.prose-doc a { color: var(--accent); text-decoration: none; }
.prose-doc a:hover { text-decoration: underline; }

.prose-doc strong { color: var(--text-1); font-weight: 600; }
.prose-doc em { color: var(--text-2); }

/* Inline code */
.prose-doc code {
  font-family: "JetBrains Mono", monospace;
  font-size: 0.8125rem;
  background: rgba(129,140,248,0.07);
  color: var(--accent);
  padding: 0.15rem 0.4rem;
  border-radius: 3px;
  border: 1px solid rgba(129,140,248,0.15);
}

/* Code block */
.prose-doc pre {
  background: var(--bg-3);
  border: 1px solid var(--border-2);
  border-radius: 6px;
  padding: 1.25rem 1.5rem;
  overflow-x: auto;
  margin: 1.5rem 0;
  position: relative;
}
.prose-doc pre::before {
  content: attr(data-lang);
  position: absolute; top: 0.75rem; right: 1rem;
  font-family: "JetBrains Mono", monospace;
  font-size: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-3);
}
.prose-doc pre code {
  background: none;
  border: none;
  padding: 0;
  font-size: 0.8125rem;
  color: var(--text-1);
}

/* Lists */
.prose-doc ul, .prose-doc ol {
  padding-left: 1.5rem;
  margin: 0 0 1.125rem;
}
.prose-doc li { margin-bottom: 0.4rem; }

/* Blockquote */
.prose-doc blockquote {
  border-left: 3px solid var(--accent);
  padding: 0.75rem 1.25rem;
  margin: 1.5rem 0;
  background: rgba(129,140,248,0.04);
  border-radius: 0 6px 6px 0;
  font-style: italic;
}

/* HR */
.prose-doc hr {
  border: none;
  border-top: 1px solid var(--border-2);
  margin: 2.5rem 0;
}

/* Table */
.prose-doc table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.875rem; }
.prose-doc th {
  text-align: left;
  padding: 0.625rem 1rem;
  font-family: "JetBrains Mono", monospace;
  font-size: 0.6rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-3);
  border-bottom: 1px solid var(--border-2);
  background: var(--bg-2);
}
.prose-doc td {
  padding: 0.625rem 1rem;
  border-bottom: 1px solid var(--border);
  color: var(--text-2);
  vertical-align: top;
}
.prose-doc tr:hover td { background: var(--bg-2); }

/* Callout */
.callout {
  display: flex; gap: 0.875rem; align-items: flex-start;
  padding: 1rem 1.125rem;
  background: rgba(129,140,248,0.05);
  border: 1px solid rgba(129,140,248,0.2);
  border-radius: 6px;
  margin: 1.5rem 0;
}
.callout-icon { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
.callout p { margin: 0; color: var(--text-2); font-size: 0.9rem; }

/* ── Mobile sidebar toggle ───────────────────── */
.sidebar-toggle {
  display: none;
  position: fixed;
  bottom: 1.25rem;
  left: 1.25rem;
  z-index: 150;
  align-items: center;
  gap: 0.5rem;
  background: var(--bg-3);
  border: 1px solid var(--border-2);
  color: var(--text-1);
  font-family: "Inter", system-ui, sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 0.5rem 0.875rem;
  cursor: pointer;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: border-color 0.15s;
}
.sidebar-toggle:hover { border-color: var(--accent); color: var(--accent); }

.sidebar-close {
  display: none;
  background: none;
  border: none;
  color: var(--text-2);
  font-size: 14px;
  cursor: pointer;
  padding: 0.25rem 0.5rem;
  margin-bottom: 1rem;
  transition: color 0.15s;
}
.sidebar-close:hover { color: var(--text-1); }

#sidebar-overlay {
  display: none;
  position: fixed;
  inset: 48px 0 0 0;
  z-index: 148;
  background: rgba(0,0,0,0.6);
  opacity: 0;
  transition: opacity 0.2s;
}
#sidebar-overlay.is-open { opacity: 1; }

/* ── Responsive ──────────────────────────────── */
@media (max-width: 1100px) {
  #docs-toc { display: none; }
}
@media (max-width: 767px) {
  #docs-sidebar {
    position: fixed;
    top: 48px;
    left: 0;
    height: calc(100vh - 48px);
    z-index: 149;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }
  #docs-sidebar.is-open { transform: translateX(0); }
  #sidebar-overlay      { display: block; }
  .sidebar-toggle       { display: flex; }
  .sidebar-close        { display: block; }
  .docs-main            { padding: 1.75rem 1.25rem 5rem; }
}
</style>
