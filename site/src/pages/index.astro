---
import Landing     from "../layouts/Landing.astro";
import Nav         from "../components/Nav.astro";
import Footer      from "../components/Footer.astro";
import SessionDemo from "../components/SessionDemo.astro";
import { VERSION } from "../lib/version";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Landing>
  <Nav />

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="hero grid-bg">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero-inner">

      <!-- LEFT: copy ──────────────────────────── -->
      <div class="hero-copy">

        <!-- Badge -->
        <div class="hero-badge">
          <span class="dot dot--pulse" aria-hidden="true"></span>
          <span>v{VERSION} &nbsp;·&nbsp; Open Source &nbsp;·&nbsp; MIT License</span>
        </div>

        <!-- Headline -->
        <div class="hero-headline">
          <div class="hero-tag">The complete monitoring system for Claude Code</div>
          <h1 class="hero-h1">20/20<br/>HINDSIGHT.</h1>
        </div>

        <!-- Sub -->
        <p class="hero-sub">
          Every tool call. Every token. Every error. Every sub-agent.
          Visualize sessions in 3D, inspect code changes with syntax highlighting,
          preview screenshots, and track costs across all your projects.
          <strong>See everything Claude does.</strong>
        </p>

        <!-- CTAs -->
        <div class="hero-actions">
          <a href={`${base}/docs/getting-started`} class="btn btn-fill">
            GET STARTED
          </a>
          <a href={`${base}/docs`} class="btn btn-outline">READ THE DOCS</a>
          <a
            href="https://github.com/Codestz/claude-hindsight"
            class="btn btn-outline"
            target="_blank"
            rel="noopener noreferrer"
          >GITHUB</a>
        </div>

        <!-- Install snippet -->
        <div class="hero-snippet">
          <div class="snippet-label">QUICK INSTALL · MACOS &amp; LINUX</div>
          <div class="snippet-block">
            <div class="snippet-lines">
              <div class="snippet-line">
                <span class="accent" aria-hidden="true">$</span>
                <span class="bright">brew tap codestz/tap</span>
              </div>
              <div class="snippet-line">
                <span class="accent" aria-hidden="true">$</span>
                <span class="bright">brew install claude-hindsight</span>
              </div>
            </div>
            <button
              class="copy-btn"
              onclick="
                navigator.clipboard.writeText('brew tap codestz/tap\nbrew install claude-hindsight');
                this.textContent = 'COPIED';
                setTimeout(() => this.textContent = 'COPY', 2000);
              "
            >COPY</button>
          </div>
        </div>

      </div>

      <!-- RIGHT: animated session demo ───────── -->
      <SessionDemo />

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       TICKER
  ═══════════════════════════════════════════ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...Array(2)].map(() => (
        <>
          <span class="tick"><span class="tick-accent">01</span>Free &amp; Open Source · MIT</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">02</span>3D force-directed session graph</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">03</span>Screenshot preview &amp; image lightbox</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">04</span>Syntax-highlighted code rendering</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">05</span>Cost tracking per turn &amp; model</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">06</span>Real-time OTLP telemetry</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">07</span>No cloud · No accounts · 100% local</span>
          <span class="tick-div">◆</span>
          <span class="tick"><span class="tick-accent">08</span>Single Rust binary · ~8 MB</span>
          <span class="tick-div">◆</span>
        </>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════
       [02] CAPABILITIES
  ═══════════════════════════════════════════ -->
  <section class="section section-sep">
    <div class="section-inner">

      <div class="section-header">
        <span class="sec-num">[02]</span>
        <span class="label">CAPABILITIES</span>
        <span class="section-line"></span>
        <span class="label muted">// what claude-hindsight gives you</span>
      </div>

      <div class="feat-bento bento">

        <!-- ── ZERO SETUP ─────────────────────── -->
        <div class="feat-cell fc-setup">
          <div class="fc-label label"><span class="accent">◈</span>&ensp;ZERO SETUP</div>
          <h3 class="fc-title">One binary.<br/>No dependencies.</h3>
          <p class="fc-desc">
            Install via Homebrew, Cargo, or download a pre-built binary.
            No Node.js, no Docker, no accounts — it just runs.
          </p>
          <div class="fc-terminal">
            <div class="ft-chrome">
              <span class="ft-dot"></span><span class="ft-dot"></span><span class="ft-dot"></span>
            </div>
            <div class="ft-body">
              <div class="ft-line"><span class="accent">$</span><span class="bright"> brew install claude-hindsight</span></div>
              <div class="ft-line muted"><span class="dim">✓&nbsp;</span>claude-hindsight {VERSION} installed</div>
              <div class="ft-line" style="margin-top:0.5rem"><span class="accent">$</span><span class="bright"> claude-hindsight init</span></div>
              <div class="ft-line muted"><span class="dim">✓&nbsp;</span>Indexed 142 sessions across 8 projects</div>
              <div class="ft-line" style="margin-top:0.5rem"><span class="accent">$</span><span class="bright"> claude-hindsight serve --open</span></div>
              <div class="ft-line"><span class="cyan">→&nbsp;</span>http://localhost:7227</div>
            </div>
          </div>
          <div class="fc-tags">
            <span class="fc-tag"><span class="accent">✓</span>&ensp;macOS &amp; Linux</span>
            <span class="fc-tag"><span class="accent">✓</span>&ensp;Rust 1.75+</span>
            <span class="fc-tag"><span class="accent">✓</span>&ensp;~8 MB binary, zero runtime deps</span>
          </div>
        </div>

        <!-- ── SESSION INSPECTOR ──────────────── -->
        <div class="feat-cell fc-explorer">
          <div class="fc-label label"><span class="cyan">◉</span>&ensp;SESSION INSPECTOR</div>
          <h3 class="fc-title">Two-panel inspector.<br/>3D graph view.</h3>
          <p class="fc-desc">
            Resizable split layout: compact execution list on the left, full node detail on the right.
            Switch to 3D graph view to visualize the entire session as an interactive force-directed graph
            with bloom lighting and node clustering. Preview screenshots, view syntax-highlighted code,
            navigate tool call ↔ result pairs.
          </p>
          <div class="fc-tree">
            <div class="ftt muted">// session_17b8f9a2.jsonl</div>
            <div class="ftt muted">│</div>
            <div class="ftt"><span class="dim">├─ </span><span class="tbadge tbadge-user">USER</span><span class="muted"> "Refactor the auth module"</span></div>
            <div class="ftt muted">│</div>
            <div class="ftt"><span class="dim">└─ </span><span class="tbadge tbadge-asst">ASST</span><span class="muted"> thinking → tool calls</span></div>
            <div class="ftt"><span class="dim">&nbsp;&nbsp; ├─ </span><span class="tbadge tbadge-think">THINK</span><span class="dim"> 892 tokens ──────────</span></div>
            <div class="ftt"><span class="dim">&nbsp;&nbsp; ├─ </span><span class="tbadge tbadge-tool">TOOL: Glob</span><span class="cyan"> src/auth/**/*.ts</span></div>
            <div class="ftt"><span class="dim">&nbsp;&nbsp; │&nbsp;&nbsp; └─ </span><span class="tbadge tbadge-result">RESULT</span><span class="muted"> 7 files matched</span></div>
            <div class="ftt"><span class="dim">&nbsp;&nbsp; ├─ </span><span class="tbadge tbadge-tool">TOOL: Bash</span><span class="cyan"> cargo clippy</span></div>
            <div class="ftt"><span class="dim">&nbsp;&nbsp; │&nbsp;&nbsp; └─ </span><span class="tbadge tbadge-ok">RESULT</span><span class="accent"> exit 0 ✓</span></div>
            <div class="ftt"><span class="dim">&nbsp;&nbsp; └─ </span><span class="tbadge tbadge-sub">SUBAGENT</span><span class="amber"> spawned → TypeScript validator</span></div>
          </div>
        </div>

        <!-- ── LIVE MONITOR ───────────────────── -->
        <div class="feat-cell fc-live">
          <div class="fc-label label">
            <span class="dot dot--pulse dot--red" style="width:5px;height:5px" aria-hidden="true"></span>
            &ensp;LIVE MONITOR
          </div>
          <h3 class="fc-title">Watch sessions as<br/>they happen.</h3>
          <p class="fc-desc">
            <code>claude-hindsight watch</code> tails an active session in real time.
            New nodes stream in as Claude works — powered by SSE, not polling.
          </p>
          <div class="fc-live-feed">
            {[
              { time: "14:21:05", badge: "tbadge-user",  label: "USER",  active: false },
              { time: "14:21:11", badge: "tbadge-think", label: "THINK", active: false },
              { time: "14:21:13", badge: "tbadge-tool",  label: "TOOL",  active: false },
              { time: "14:21:18", badge: "tbadge-tool",  label: "TOOL",  active: false },
              { time: "14:21:22", badge: "tbadge-sub",   label: "SUB",   active: true  },
            ].map((r) => (
              <div class={`live-row ${r.active ? "live-row--active" : ""}`}>
                <span class="live-time">{r.time}</span>
                <span class={`tbadge ${r.badge}`}>{r.label}</span>
                {r.active && <span class="cursor"></span>}
              </div>
            ))}
          </div>
        </div>

        <!-- ── COST & ERROR TRACKING ─────────── -->
        <div class="feat-cell fc-tokens">
          <div class="fc-label label"><span class="amber">◐</span>&ensp;COST &amp; ERROR TRACKING</div>
          <h3 class="fc-title">Every dollar.<br/>Every failure.</h3>
          <p class="fc-desc">
            Track token costs per turn, per model, per project.
            Timeline scrubber shows cost distribution.
            Filter errors across all sessions with one click.
          </p>
          <div class="fc-chart">
            {[
              { lbl: "Glob  ", pct: "80%", cls: "",   val: "47 calls", vcls: "bright"  },
              { lbl: "Bash  ", pct: "53%", cls: "bc", val: "31 calls", vcls: "cyan"    },
              { lbl: "Edit  ", pct: "32%", cls: "ba", val: "19 calls", vcls: "amber"   },
            ].map((r) => (
              <div class="tkn-row">
                <span class="tkn-lbl">{r.lbl}</span>
                <span class="tkn-bar"><span class={`tkn-fill ${r.cls}`} style={`width:${r.pct}`}></span></span>
                <span class={`tkn-val ${r.vcls}`}>{r.val}</span>
              </div>
            ))}
            <div class="tkn-div"></div>
            <div class="tkn-sum">
              <div>
                <div class="label muted">TOTAL SESSIONS</div>
                <div class="bright tkn-total">142</div>
              </div>
              <div style="text-align:right">
                <div class="label muted">ERRORS FOUND</div>
                <div class="accent tkn-total">3</div>
              </div>
            </div>
          </div>
        </div>

        <!-- ── DUAL INTERFACE ─────────────────── -->
        <div class="feat-cell fc-dual">
          <div class="fc-label label"><span class="purple">⬡</span>&ensp;TWO INTERFACES</div>
          <h3 class="fc-title">Terminal or browser.<br/>Same data, your choice.</h3>
          <p class="fc-desc">
            The TUI lives in your terminal, the web dashboard opens in your browser.
            Both read the same SQLite index. Pick the one that fits your workflow.
          </p>
          <div class="fc-dual-grid">
            <div class="dual-panel">
              <div class="dual-label accent">TERMINAL UI</div>
              <div class="dual-code">
                <div><span class="dim">$&nbsp;</span><span class="bright">claude-hindsight</span></div>
                <div><span class="dim">$&nbsp;</span><span class="bright">claude-hindsight list</span></div>
                <div><span class="dim">$&nbsp;</span><span class="bright">claude-hindsight watch</span></div>
                <div><span class="dim">$&nbsp;</span><span class="bright">claude-hindsight show &lt;id&gt;</span></div>
              </div>
              <div class="dual-meta">ratatui · crossterm · j/k navigation</div>
            </div>
            <div class="dual-sep"></div>
            <div class="dual-panel">
              <div class="dual-label cyan">WEB DASHBOARD</div>
              <div class="dual-code">
                <div><span class="dim">$&nbsp;</span><span class="bright">claude-hindsight serve</span></div>
                <div><span class="cyan">→&nbsp;localhost:7227</span></div>
                <div class="muted" style="margin-top:0.375rem">Sessions · Analytics</div>
                <div class="muted">Live feed · Search</div>
              </div>
              <div class="dual-meta">Vite + React Router · embedded in binary</div>
            </div>
          </div>
        </div>

        <!-- ── LOCAL FIRST ────────────────────── -->
        <div class="feat-cell fc-local">
          <div class="fc-label label"><span class="accent">◉</span>&ensp;LOCAL FIRST</div>
          <h3 class="fc-title">Your data never<br/>leaves your machine.</h3>
          <p class="fc-desc">
            Hindsight reads Claude's JSONL files directly.
            Nothing leaves your disk.
          </p>
          <div class="fc-list">
            {[
              "No network requests",
              "No telemetry or tracking",
              "No accounts, no sign-up",
              "Read-only — never modifies sessions",
              "ACID-compliant SQLite on disk",
              "Memory-safe Rust throughout",
            ].map((item) => (
              <div class="local-item">
                <span class="accent" aria-hidden="true">✓</span>
                <span class="muted">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- ── REAL-TIME HOOKS ────────────────── -->
        <div class="feat-cell fc-hooks">
          <div class="fc-hooks-inner">
            <div class="fc-hooks-copy">
              <div class="fc-label label"><span class="amber">⚡</span>&ensp;REAL-TIME HOOKS</div>
              <h3 class="fc-title">One command.<br/>Every session captured.</h3>
              <p class="fc-desc">
                <code>claude-hindsight integrate --otel</code> installs two Claude Code hooks
                and starts the OTLP daemon. From that moment, every tool call streams into the
                Activity Timeline automatically — zero manual steps.
              </p>
              <div class="fc-tags">
                <span class="fc-tag"><span class="amber">✓</span>&ensp;UserPromptSubmit + PreToolUse hooks</span>
                <span class="fc-tag"><span class="amber">✓</span>&ensp;OTLP telemetry on port :7228</span>
                <span class="fc-tag"><span class="amber">✓</span>&ensp;Background daemon auto-starts</span>
              </div>
            </div>
            <div class="fc-hooks-terminal">
              <div class="ft-chrome">
                <span class="ft-dot"></span><span class="ft-dot"></span><span class="ft-dot"></span>
              </div>
              <div class="ft-body">
                <div class="ft-line"><span class="accent">$</span><span class="bright"> claude-hindsight integrate --otel</span></div>
                <div class="ft-line"><span class="accent">✓&nbsp;</span><span class="muted">Installing Claude Code hooks...</span></div>
                <div class="ft-line"><span class="accent">✓&nbsp;</span><span class="muted">PreToolUse hook → installed</span></div>
                <div class="ft-line"><span class="accent">✓&nbsp;</span><span class="muted">UserPromptSubmit hook → installed</span></div>
                <div class="ft-line"><span class="accent">✓&nbsp;</span><span class="muted">OTLP exporter → :7228</span></div>
                <div class="ft-line"><span class="accent">✓&nbsp;</span><span class="bright">Done. Sessions now auto-indexed.</span></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       [03] WHAT'S NEW IN v2.2
  ═══════════════════════════════════════════ -->
  <section class="section section-sep">
    <div class="section-inner">

      <div class="section-header">
        <span class="sec-num">[03]</span>
        <span class="label">WHAT'S NEW IN v{VERSION}</span>
        <span class="section-line"></span>
        <span class="label muted">// latest release highlights</span>
      </div>

      <div class="whats-new-grid bento">
        {[
          {
            icon: "◎", color: "var(--accent)", title: "3D Session Graph",
            desc: "Visualize entire sessions as interactive force-directed graphs. Radial DAG layout, bloom lighting, click-to-focus camera. Powered by Three.js + WebGL.",
          },
          {
            icon: "◉", color: "var(--cyan)", title: "Image Previews",
            desc: "Screenshots embedded in tool results render as inline previews with expand-to-lightbox. Base64 data decoded directly — works even after files are deleted.",
          },
          {
            icon: "◈", color: "var(--amber)", title: "Smart Tool Rendering",
            desc: "Read, Edit, Write, Bash — each tool type gets a specialized display. MCP tools show server badges. Syntax highlighting for 8+ languages.",
          },
          {
            icon: "↻", color: "var(--purple)", title: "Task Notifications",
            desc: "Sub-agent completions parsed from XML into structured cards with status, token usage, duration, and markdown result rendering.",
          },
          {
            icon: "⊕", color: "var(--green)", title: "Timeline Scrubber",
            desc: "Horizontal timeline bar with colored node markers. Click anywhere to jump. Token-per-turn cost bars overlay in the background.",
          },
          {
            icon: "⚡", color: "var(--red)", title: "Unified Error Tracking",
            desc: "Global error count consistent across Dashboard and Activity. Errors tab loads failure events separately so they're always visible.",
          },
        ].map((item) => (
          <div class="wn-card">
            <div class="wn-icon" style={`color:${item.color}`}>{item.icon}</div>
            <div class="wn-title">{item.title}</div>
            <div class="wn-desc">{item.desc}</div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       [04] HOW IT WORKS
  ═══════════════════════════════════════════ -->
  <section class="section section-sep">
    <div class="section-inner">

      <div class="section-header">
        <span class="sec-num">[04]</span>
        <span class="label">UP AND RUNNING IN 60 SECONDS</span>
        <span class="section-line"></span>
      </div>

      <div class="steps-grid bento">
        {[
          {
            num: "01", title: "INSTALL",
            desc: "One command via Homebrew or cargo install. Pre-built binaries have zero external dependencies — no Node.js, no Python, nothing.",
            lines: [
              { t: "prompt",  text: "brew tap codestz/tap"      },
              { t: "dim",     text: "==> Tapping codestz/tap..." },
              { t: "prompt",  text: "brew install claude-hindsight"           },
              { t: "success", text: `✓  claude-hindsight ${VERSION} installed` },
            ],
          },
          {
            num: "02", title: "INDEX",
            desc: "Scan ~/.claude/projects/ and build a local SQLite index. Takes seconds even for hundreds of sessions.",
            lines: [
              { t: "prompt",  text: "claude-hindsight init"                       },
              { t: "dim",     text: "Scanning ~/.claude/projects/"          },
              { t: "success", text: "✓  Indexed 142 sessions, 8 projects"  },
              { t: "success", text: "✓  Index → ~/.local/share/claude-hindsight/" },
            ],
          },
          {
            num: "03", title: "EXPLORE",
            desc: "Launch the web dashboard, fire up the TUI, or watch an active session stream live. Your sessions, your way.",
            lines: [
              { t: "prompt",  text: "claude-hindsight serve --open" },
              { t: "cyan",    text: "→  http://localhost:7227" },
              { t: "dim",     text: "Press Ctrl+C to stop"    },
              { t: "prompt",  text: "claude-hindsight watch"         },
            ],
          },
          {
            num: "04", title: "INTEGRATE",
            desc: "One command installs Claude Code hooks and starts the OTLP daemon. Every future session is indexed and streamed live — automatically.",
            lines: [
              { t: "prompt",  text: "claude-hindsight integrate --otel"   },
              { t: "success", text: "✓  PreToolUse hook → installed"       },
              { t: "success", text: "✓  OTLP exporter → :7228"             },
              { t: "success", text: "✓  Done. Sessions auto-indexed."      },
            ],
          },
        ].map((step) => (
          <div class="step">
            <div class="step-num">{step.num}</div>
            <div class="step-title">{step.title}</div>
            <p class="step-desc">{step.desc}</p>
            <div class="step-term">
              <div class="sterm-chrome">
                <span class="sterm-dot"></span>
                <span class="sterm-dot"></span>
                <span class="sterm-dot"></span>
              </div>
              <div class="sterm-body">
                {step.lines.map((line) => (
                  <div class="sterm-line">
                    {line.t === "prompt"  && <><span class="accent">$&nbsp;</span><span class="bright">{line.text}</span></>}
                    {line.t === "dim"     && <span class="muted">{line.text}</span>}
                    {line.t === "success" && <span class="accent">{line.text}</span>}
                    {line.t === "cyan"    && <><span class="dim">&nbsp;&nbsp;</span><span class="cyan">{line.text}</span></>}
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       [04] INSTALL
  ═══════════════════════════════════════════ -->
  <section id="install" class="section section-sep">
    <div class="section-inner">

      <div class="section-header">
        <span class="sec-num">[05]</span>
        <span class="label">INSTALL</span>
        <span class="section-line"></span>
        <span class="label muted">// pick your method</span>
      </div>

      <div class="install-grid bento">
        {[
          {
            method: "HOMEBREW",
            note: "macOS &amp; Linux — Recommended",
            lines: ["brew tap codestz/tap", "brew install claude-hindsight"],
          },
          {
            method: "CARGO",
            note: "Rust toolchain required",
            lines: ["cargo install claude-hindsight"],
          },
          {
            method: "BUILD FROM SOURCE",
            note: "For contributors",
            lines: [
              "git clone https://github.com/Codestz/claude-hindsight",
              "cd claude-hindsight && make build",
            ],
          },
        ].map((block) => (
          <div class="inst-block">
            <div class="inst-header">
              <div>
                <div class="inst-method">{block.method}</div>
                <div class="inst-note" set:html={block.note}></div>
              </div>
              <button
                class="copy-btn"
                onclick={`
                  navigator.clipboard.writeText(${JSON.stringify(block.lines.join('\n'))});
                  this.textContent = 'COPIED';
                  setTimeout(() => this.textContent = 'COPY', 2000);
                `}
              >COPY</button>
            </div>
            <div class="inst-code">
              {block.lines.map((line) => (
                <div class="inst-line">
                  <span class="accent" aria-hidden="true">$&nbsp;</span>
                  <span class="bright">{line}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="inst-footer">
        <a href={`${base}/docs/getting-started`} class="inst-docs-link">
          Read the full getting started guide →
        </a>
      </div>

    </div>
  </section>

  <Footer />
</Landing>

<style>
/* ─── HERO ───────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100vh;
  padding-top: 48px;
  border-bottom: 1px solid var(--border);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 1000px;
  height: 640px;
  background: radial-gradient(ellipse at center,
    rgba(129,140,248,0.08) 0%,
    transparent 68%);
  pointer-events: none;
}

.hero-inner {
  position: relative;
  max-width: 1280px;
  margin: 0 auto;
  padding: 5.5rem 2.5rem 5rem;
  display: grid;
  grid-template-columns: 5fr 7fr;
  gap: 4rem;
  align-items: center;
  min-height: calc(100vh - 48px);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 2.25rem;
}

/* Badge */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  font-family: var(--sans);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-2);
  border: 1px solid var(--border-2);
  padding: 0.375rem 0.875rem;
  width: fit-content;
}

.hero-headline { display: flex; flex-direction: column; gap: 0.25rem; }

.hero-tag {
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-2);
  letter-spacing: 0.01em;
}

.hero-h1 {
  font-family: "Inter", system-ui, sans-serif;
  font-size: clamp(2.75rem, 5.5vw, 5.5rem);
  font-weight: 900;
  line-height: 1.0;
  letter-spacing: -0.04em;
  color: var(--text-1);
}

.hero-sub {
  font-family: var(--sans);
  font-size: 16px;
  color: var(--text-2);
  line-height: 1.75;
  max-width: 500px;
}

.hero-sub strong {
  color: var(--text-1);
  font-weight: 600;
}

.hero-actions {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

/* Buttons inherit size here */
.btn { font-size: 11px; }

.hero-snippet { display: flex; flex-direction: column; gap: 0.625rem; }

.snippet-label {
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-2);
}

.snippet-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  background: var(--bg-2);
  border: 1px solid var(--border);
  padding: 1rem 1.25rem;
}

.snippet-lines { display: flex; flex-direction: column; gap: 0.25rem; }

.snippet-line {
  font-family: "JetBrains Mono", monospace;
  font-size: 13px;
  display: flex;
  gap: 0.625rem;
}

/* (mockup chrome styles live in SessionDemo.astro) */

/* ─── TICKER ─────────────────────────────────── */
.ticker {
  position: relative;
  background: var(--bg-2);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  overflow: hidden;
  white-space: nowrap;
  height: 56px;
  display: flex;
  align-items: center;
  /* Edge fade */
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%);
  mask-image:         linear-gradient(to right, transparent 0%, black 7%, black 93%, transparent 100%);
}

.ticker-track {
  display: inline-flex;
  align-items: center;
  animation: ticker 50s linear infinite;
}

.tick {
  font-family: var(--sans);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-2);
  padding: 0 2.75rem;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
}

.tick-accent {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.1em;
}

.tick-div {
  color: var(--text-3);
  font-size: 7px;
  flex-shrink: 0;
}

@keyframes ticker {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ─── SECTION SHELL ──────────────────────────── */
.section { padding: 5rem 0; }
.section-inner { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
.section-sep { border-top: 1px solid var(--border); }

.section-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2.75rem;
}
.section-line { flex: 1; height: 1px; background: var(--border); }
.sec-num {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--accent);
}

/* ─── CAPABILITIES BENTO ─────────────────────── */
.feat-bento { grid-template-columns: repeat(12, 1fr); }

.fc-setup    { grid-column: span 4; }
.fc-explorer { grid-column: span 5; }
.fc-live     { grid-column: span 3; }
.fc-tokens   { grid-column: span 4; }
.fc-dual     { grid-column: span 5; }
.fc-local    { grid-column: span 3; }
.fc-hooks    { grid-column: span 12; }

/* Hooks cell internal layout */
.fc-hooks-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem;
  align-items: start;
}

.fc-hooks-terminal {
  border: 1px solid var(--border);
  overflow: hidden;
}

.feat-cell {
  background: var(--bg);
  padding: 2.25rem;
  position: relative;
  overflow: hidden;
  transition: background 0.2s;
}

.feat-cell::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: var(--accent);
  opacity: 0;
  transition: opacity 0.3s;
}
.feat-cell:hover { background: var(--bg-2); }
.feat-cell:hover::before { opacity: 0.5; }

.fc-label {
  font-family: var(--sans);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-2);
  margin-bottom: 1.125rem;
  display: flex;
  align-items: center;
}

.fc-title {
  font-family: "Inter", system-ui, sans-serif;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text-1);
  margin: 0 0 1rem;
  letter-spacing: -0.01em;
}

.fc-desc {
  font-family: var(--sans);
  font-size: 14px;
  color: var(--text-2);
  line-height: 1.7;
  margin: 0 0 1.5rem;
}

/* Feature terminal */
.fc-terminal { border: 1px solid var(--border); overflow: hidden; margin-bottom: 1.5rem; }
.ft-chrome {
  display: flex;
  gap: 5px;
  padding: 6px 12px;
  background: var(--bg-3);
  border-bottom: 1px solid var(--border);
}
.ft-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--border-2); }
.ft-body {
  padding: 1rem 1.125rem;
  font-family: "JetBrains Mono", monospace;
  font-size: 13px;
  display: flex;
  flex-direction: column;
