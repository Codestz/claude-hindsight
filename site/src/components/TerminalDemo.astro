---
interface Props {
  lines: { prompt?: boolean; text: string; color?: string }[];
  title?: string;
  showCopyButton?: boolean;
}
const { lines, title = "bash", showCopyButton = false } = Astro.props;
---
<div style="background: var(--surface-1); border: 1px solid var(--border-1); border-radius: 6px; overflow: hidden;">
  <div style="
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border-1);
    background: var(--surface-2);
  ">
    <div style="display: flex; align-items: center; gap: 0.375rem;">
      <span style="width: 10px; height: 10px; border-radius: 50%; background: #F85149; opacity: 0.6;" aria-hidden="true"></span>
      <span style="width: 10px; height: 10px; border-radius: 50%; background: #D29922; opacity: 0.6;" aria-hidden="true"></span>
      <span style="width: 10px; height: 10px; border-radius: 50%; background: #3FB950; opacity: 0.6;" aria-hidden="true"></span>
      <span class="mono" style="margin-left: 0.5rem; font-size: 0.6875rem; color: var(--text-3);">{title}</span>
    </div>
    {showCopyButton && (
      <button
        style="font-size: 0.6875rem; color: var(--text-3); background: none; border: none; cursor: pointer; font-family: 'JetBrains Mono', monospace;"
        aria-label="Copy code to clipboard"
      >
        Copy
      </button>
    )}
  </div>
  <div style="padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.375rem;">
    {lines.map((line) => (
      <div class="mono" style="font-size: 0.8125rem; line-height: 1.6; display: flex; align-items: flex-start; gap: 0.625rem;">
        {line.prompt && <span style="color: var(--accent); flex-shrink: 0;" aria-hidden="true">$</span>}
        <span style={line.color ? `color: ${line.color}` : line.prompt ? "color: var(--text-1)" : "color: var(--text-3)"}>
          {line.text}
        </span>
      </div>
    ))}
  </div>
</div>
