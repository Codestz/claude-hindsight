---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<header id="nav">
  <div class="nav-inner">

    <!-- Brand -->
    <a href={`${base}/`} class="nav-brand" aria-label="Hindsight home">
      <span class="nav-logo">HINDSIGHT</span>
      <span class="nav-version">v1.0.0</span>
    </a>

    <!-- Spacer -->
    <div style="flex:1"></div>

    <!-- Links -->
    <nav class="nav-links" aria-label="Main navigation">
      <a href={`${base}/docs`} class="nav-link">DOCS</a>
      <a
        href="https://github.com/Codestz/claude-hindsight"
        class="nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >GITHUB</a>
      <a href="#install" class="nav-link nav-cta">INSTALL</a>
    </nav>

  </div>
</header>

<style>
  #nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    height: 48px;
    background: rgba(5,5,5,0.97);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
    text-decoration: none;
  }

  .nav-logo {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--text-1);
  }

  .nav-version {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: var(--accent);
    border: 1px solid rgba(0,255,136,0.25);
    padding: 2px 7px;
    letter-spacing: 0.05em;
  }

  .nav-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
  }

  .nav-status-text {
    font-family: "Space Mono", monospace;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-3);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-1);
    padding: 0.375rem 0.875rem;
    text-decoration: none;
    opacity: 0.55;
    transition: opacity 0.15s;
  }
  .nav-link:hover { opacity: 1; }

  .nav-cta {
    opacity: 1;
    color: var(--accent);
    border: 1px solid rgba(0,255,136,0.35);
    transition: background 0.15s;
  }
  .nav-cta:hover {
    background: rgba(0,255,136,0.08);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .nav-status { display: none; }
    .nav-inner  { gap: 1rem; }
  }
</style>
